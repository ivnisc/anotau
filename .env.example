# cliente: exportar estas variables al ejecutar anotau.
ANOTAU_SERVER_URL=https://localhost:8443/
ANOTAU_CA_CERT=./localhost.crt

# compose: rutas internas al contenedor, dentro del volumen /data.
ANOTAU_DATABASE=/data/anotau.sqlite3
ANOTAU_TLS_CERT=/data/localhost.crt
ANOTAU_TLS_KEY=/data/localhost.key
# nombre que ve el cliente al iniciar sesión; 1 deja solo /v1/health durante una mantención.
ANOTAU_SERVER_NAME=anotau-dev
ANOTAU_MAINTENANCE=0
# respaldos diarios con VACUUM INTO; en la VM, mejor en otro disco que la base.
ANOTAU_BACKUP_DIR=/data/backups
ANOTAU_BACKUP_KEEP=7
ANOTAU_BIND_IP=127.0.0.1
ANOTAU_PORT=8443
